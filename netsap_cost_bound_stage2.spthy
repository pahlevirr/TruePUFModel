theory NETSAP_PUF
begin

builtins: hashing, symmetric-encryption

functions: puf/2 [private], pufn/3 [private], us/1

#ifdef BOUND
macros: tokc(s,pm,c) = h(<'cli',s,pm,c>), toks(s,pm,c) = h(<'srv',s,pm,c>)
#endif
#ifdef TAGGED
macros: tokc(s,pm,c) = h(<'cli',s,pm>), toks(s,pm,c) = h(<'srv',s,pm>)
#endif
#ifdef PUBLISHED
macros: tokc(s,pm,c) = h(<'tok',s,pm>), toks(s,pm,c) = h(<'tok',s,pm>)
#endif

rule Manufacture:
  [ Fr(~t) ] --[ Make($D, ~t) ]-> [ !Dev($D, ~t) ]

restriction OneFingerprintPerDevice:
  "All D t1 t2 #i #j. Make(D,t1)@i & Make(D,t2)@j ==> t1 = t2"

rule PUFok:
  [ PUFin(D,c), !Dev(D,t) ]
  --[ PUF(D,c) ]->
  [ PUFout(D,c,puf(t,c)) ]

rule PUFnoisy:
  [ PUFin(D,c), !Dev(D,t), Fr(~n) ]
  --[ PUF(D,c), RepFail(D,c) ]->
  [ PUFout(D,c,pufn(t,c,~n)) ]

restriction OneEnrollmentPerDevice:
  "All A1 A2 D #i #j. Enrolled(A1,D)@i & Enrolled(A2,D)@j ==> #i = #j"

#ifdef SMALL_CAP

rule Enroll:
  [ !Dev(D,t), Fr(~s0), Fr(~pm) ]
  --[ Enrolled($A,D), CRP($A,D,'c0'), SeedFact(D,~s0), PmOf(D,~pm) ]->
  [ !CRPout($A,D,'c0',puf(t,'c0')), !Reg($A,D), !Avail($A,D,'c0')
  , !Params(D,~pm), !CSeed(D,~s0), !SSeed($A,D,~s0) ]
#else

rule Enroll:
  [ !Dev(D,t), Fr(~c0), Fr(~c1), Fr(~s0), Fr(~pm) ]
  --[ Enrolled($A,D), CRP($A,D,~c0), CRP($A,D,~c1), SeedFact(D,~s0), PmOf(D,~pm) ]->
  [ !CRPout($A,D,~c0,puf(t,~c0)), !CRPout($A,D,~c1,puf(t,~c1)), !Reg($A,D)
  , !Avail($A,D,~c0), !Avail($A,D,~c1)
  , !Params(D,~pm), !CSeed(D,~s0), !SSeed($A,D,~s0) ]
#endif

restriction EnrollBeforeDeploy:
  "All A D c1 c2 #i #j. CRP(A,D,c1)@i & PUF(D,c2)@j ==> #i < #j"

#ifdef SMALL_CAP
restriction C_DeviceAnswersOnlyC0:
  "All D c #i. PUF(D,c)@i ==> c = 'c0'"
restriction C_PhysicalAccessOnlyC0:
  "All D c #i. BreakPUF(D,c)@i ==> c = 'c0'"
#endif

rule BreakPUF:
  [ !Dev(D,t), In(<D,c>) ]
  --[ BreakPUF(D,c) ]->
  [ Out(puf(t,c)) ]

rule RevealCRP:
  [ !CRPout(A,D,c,r) ]
  --[ RevealCRP(A,D,c) ]->
  [ Out(<c,r>) ]

rule ModelClean:
  [ !Dev(D,t), In(<D,c,puf(t,c1)>) ]
  --[ Model(D) ]->
  [ Out(puf(t,c)) ]

rule LeakFW:
  [ !Params(D,pm), !CSeed(D,s) ]
  --[ LeakFW(D) ]->
  [ Out(<pm,s>) ]

rule Collide:
  [ !Dev(D,t) ]
  --[ Collide(D,$D2), Make($D2,t) ]->
  [ !Dev($D2,t), !Collider($D2) ]

rule ColliderQuery:
  [ !Dev(D2,t), !Collider(D2), In(c) ]
  --[ ColliderQuery(D2,c) ]->
  [ Out(puf(t,c)) ]

restriction CollideDistinct:
  "All D D2 #i. Collide(D,D2)@i ==> not (D = D2)"

restriction AtMostOneCollision:
  "All D1 D2 D3 D4 #i #j. Collide(D1,D2)@i & Collide(D3,D4)@j ==> #i = #j"

#ifdef ASSUME_UNIQUE
restriction U_Uniqueness:
  "not (Ex D D2 #i. Collide(D,D2)@i)"
#endif

#ifdef ASSUME_RELIABLE
restriction R_ReproductionNeverFails:
  "not (Ex D c #i. RepFail(D,c)@i)"
#endif

#ifdef ASSUME_INDEP
restriction I_Independence:
  "not (Ex D #i. Model(D)@i)"
#endif

restriction ServerOncePerSeed:
  "All A D c1 c2 s #i #j. SVal(A,D,c1,s)@i & SVal(A,D,c2,s)@j ==> #i = #j"

restriction ClientSeedCurrent:
  "All D s #i #j. CAuth(D,s)@i & CCommit(D,s)@j ==> not (#j < #i)"

rule C_init:
  [ !Reg(A,D) ]
  --[ CInit(D,A) ]->
  [ Out(<'req', D>), C1(D,A) ]

rule S_start:
  [ In(<'req', D>), !Reg(A,D), !Avail(A,D,c), Fr(~n) ]
  --[ Start(A,D,c,~n) ]->
  [ Out(c), S1(A,D,c,~n) ]

rule C_resp:
  [ C1(D,A), !CSeed(D,s), !Params(D,pm), In(c) ]
  --[ CAuth(D,s), SeedUse(D,s) ]->
  [ PUFin(D,c), C2(D,A,s,pm,c) ]

rule C_send:
  [ C2(D,A,s,pm,c), PUFout(D,c,y) ]
  --[ Run(D,A,<'DtoA',c,s>) ]->
  [ Out(<'auth', D, senc(tokc(s,pm,c), y)>), C3(D,A,s,pm,c,y) ]

rule S_val:
  [ S1(A,D,c,n), !CRPout(A,D,c,r), !SSeed(A,D,s), !Params(D,pm)
  , In(<'auth', D, senc(tokc(s,pm,c), r)>) ]
  --[ SVal(A,D,c,s), Commit(A,D,<'DtoA',c,s>), VSess(A,D,c,n,s)
    , Run(A,D,<'AtoD',c,s>), SeedUse(D,s), SeedFact(D,us(s)) ]->
  [ Out(<'ack', D, senc(toks(us(s),pm,c), r)>), !SSeed(A,D,us(s)) ]

rule C_fin:
  [ C3(D,A,s,pm,c,y)
  , In(<'ack', D, senc(toks(us(s),pm,c), y)>) ]
  --[ CCommit(D,s), Commit(D,A,<'AtoD',c,s>), SeedUse(D,s), SeedFact(D,us(s)) ]->
  [ !CSeed(D,us(s)) ]

lemma Sanity:
  exists-trace
  "Ex A D c s n #w #i #j.
     Start(A,D,c,n)@w & Commit(A,D,<'DtoA',c,s>)@i & Commit(D,A,<'AtoD',c,s>)@j
     & w < i & i < j"

lemma modelPUF [reuse, use_induction]:
  "All D #k. Model(D)@k ==>
     (Ex G c #i. RevealCRP(G,D,c)@i & i < k)
   | (Ex c #i. BreakPUF(D,c)@i & i < k)
   | (Ex D2 #i. Collide(D,D2)@i & i < k)
   | (Ex D2 #i. Collide(D2,D)@i & i < k)"

lemma Secrecy [reuse, use_induction]:
  "All t c p #k. K(p)@k & p = puf(t,c) ==>
     (Ex D G #m #i. Make(D,t)@m & RevealCRP(G,D,c)@i & i < k)
   | (Ex D #m #i. Make(D,t)@m & BreakPUF(D,c)@i & i < k)
   | (Ex D #m #i. Make(D,t)@m & Model(D)@i & i < k)
   | (Ex D D2 #m #i. Make(D,t)@m & Collide(D,D2)@i & i < k)"

lemma H_Puf [reuse, use_induction]:
  "All t c #k. !KU(puf(t,c))@k ==>
     (Ex D G #m #i. Make(D,t)@m & RevealCRP(G,D,c)@i & i < k)
   | (Ex D #m #i. Make(D,t)@m & BreakPUF(D,c)@i & i < k)
   | (Ex D #m #i. Make(D,t)@m & Model(D)@i & i < k)
   | (Ex D D2 #m #i. Make(D,t)@m & Collide(D,D2)@i & i < k)"

lemma H_Pm [reuse]:
  "All D pm #e #k. PmOf(D,pm)@e & !KU(pm)@k ==> (Ex #l. LeakFW(D)@l & l < k)"

lemma H_SeedUse [reuse]:
  "All D s #i. SeedUse(D,s)@i ==> (Ex #j. SeedFact(D,s)@j & j < i)"

lemma H_SeedOwner [reuse, use_induction]:
  "All D F s #i #j. SeedFact(D,s)@i & SeedFact(F,s)@j ==> D = F"

lemma H_DtoA_once [reuse]:
  "All E F B C c c2 s #k #t. Commit(E,F,<'DtoA',c,s>)@k & Commit(B,C,<'DtoA',c2,s>)@t ==> #k = #t"

#ifdef BOUND
lemma H_Tok [reuse]:
  "All D s pm c #e #k. PmOf(D,pm)@e & !KU(h(<'cli',s,pm,c>))@k ==>
     (Ex #l. LeakFW(D)@l & l < k) | (Ex A #j. Run(D,A,<'DtoA',c,s>)@j & j < k)"
#endif
#ifdef TAGGED
lemma H_Tok [reuse]:
  "All D s pm #e #k. PmOf(D,pm)@e & !KU(h(<'cli',s,pm>))@k ==>
     (Ex #l. LeakFW(D)@l & l < k) | (Ex A c #j. Run(D,A,<'DtoA',c,s>)@j & j < k)"
#endif

#ifdef PUBLISHED
#else

lemma Agree_DtoA_ni [reuse]:
  "All B C c s #t. Commit(B,C,<'DtoA',c,s>)@t ==>
     ( (Ex #j. Run(C,B,<'DtoA',c,s>)@j & j < t)
     | (Ex G c2 #r. RevealCRP(G,C,c2)@r & r < t)
     | (Ex c2 #r. BreakPUF(C,c2)@r & r < t)
     | (Ex #r. Model(C)@r & r < t)
     | (Ex D2 #r. Collide(C,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,C)@r & r < t) )"
#endif

#ifdef PUBLISHED

lemma H_CSeedSrc [reuse]:
  "All D s #i. CAuth(D,us(s))@i ==> (Ex #j. CCommit(D,s)@j & j < i)"

lemma H_MakeCol [reuse]:
  "All D1 D2 t #i #j. Make(D1,t)@i & Make(D2,t)@j ==>
     (D1 = D2) | (Collide(D1,D2)@j) | (Collide(D2,D1)@i)"

lemma Agree_AtoD_ni [use_induction, hide_lemma=H_SeedUse, hide_lemma=H_SeedOwner, hide_lemma=H_DtoA_once, hide_lemma=H_Pm, hide_lemma=Secrecy]:
  "All B C c s #t. Commit(B,C,<'AtoD',c,s>)@t ==>
     ( (Ex #j. Run(C,B,<'AtoD',c,s>)@j & j < t)
     | (Ex G c2 #r. RevealCRP(G,B,c2)@r & r < t)
     | (Ex c2 #r. BreakPUF(B,c2)@r & r < t)
     | (Ex #r. Model(B)@r & r < t)
     | (Ex D2 #r. Collide(B,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,B)@r & r < t) )"

lemma Agree_AtoD_ni_nocol [use_induction, hide_lemma=H_SeedUse, hide_lemma=H_SeedOwner, hide_lemma=H_DtoA_once, hide_lemma=H_Pm, hide_lemma=Secrecy]:
  "All B C c s #t. Commit(B,C,<'AtoD',c,s>)@t & not (Ex X Y #r. Collide(X,Y)@r & r < t) ==>
     ( (Ex #j. Run(C,B,<'AtoD',c,s>)@j & j < t)
     | (Ex G c2 #r. RevealCRP(G,B,c2)@r & r < t)
     | (Ex c2 #r. BreakPUF(B,c2)@r & r < t)
     | (Ex #r. Model(B)@r & r < t) )"
#else
lemma Agree_AtoD_ni [reuse]:
  "All B C c s #t. Commit(B,C,<'AtoD',c,s>)@t ==>
     ( (Ex #j. Run(C,B,<'AtoD',c,s>)@j & j < t)
     | (Ex G c2 #r. RevealCRP(G,B,c2)@r & r < t)
     | (Ex c2 #r. BreakPUF(B,c2)@r & r < t)
     | (Ex #r. Model(B)@r & r < t)
     | (Ex D2 #r. Collide(B,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,B)@r & r < t) )"
#endif

lemma Att_AckReplay:
  exists-trace
  "Ex D A c s n #a #b #w #v #i #j.
     CAuth(D,s)@a & CAuth(D,s)@b & Start(A,D,c,n)@w & SVal(A,D,c,s)@v
     & Commit(D,A,<'AtoD',c,s>)@i & Commit(D,A,<'AtoD',c,s>)@j
     & a < b & b < v & w < v & v < i & i < j
     & (All A2 D2 c2 n2 #w2. Start(A2,D2,c2,n2)@w2 ==> #w2 = #w)
     & (All D2 s2 #x. CAuth(D2,s2)@x ==> (#x = #a | #x = #b))
     & not (Ex D1 c1 #k. BreakPUF(D1,c1)@k)
     & not (Ex G D1 c1 #k. RevealCRP(G,D1,c1)@k)
     & not (Ex D1 #k. Model(D1)@k)
     & not (Ex D1 D2 #k. Collide(D1,D2)@k)
     & not (Ex D1 #k. LeakFW(D1)@k)
     & not (Ex D1 c1 #k. RepFail(D1,c1)@k)"

#ifdef PUBLISHED
lemma Att_AckReflect [hide_lemma=H_CSeedSrc, hide_lemma=H_MakeCol]:
  exists-trace
  "Ex D A c c2 s #a #b #v #i #e #j.
     CAuth(D,s)@a & CAuth(D,s)@b & SVal(A,D,c,s)@v & Commit(D,A,<'AtoD',c,s>)@i
     & CAuth(D,us(s))@e & Commit(D,A,<'AtoD',c2,s>)@j
     & a < v & b < i & v < i & i < e & e < j & not (c = c2)
     & not (Ex #r. Run(A,D,<'AtoD',c2,s>)@r)
     & (All A2 D2 c3 s2 #x. SVal(A2,D2,c3,s2)@x ==> #x = #v)
     & (All D2 s2 #x. CAuth(D2,s2)@x ==> (#x = #a | #x = #b | #x = #e))
     & not (Ex D1 c1 #k. BreakPUF(D1,c1)@k)
     & not (Ex G D1 c1 #k. RevealCRP(G,D1,c1)@k)
     & not (Ex D1 #k. Model(D1)@k)
     & not (Ex D1 D2 #k. Collide(D1,D2)@k)
     & not (Ex D1 #k. LeakFW(D1)@k)
     & not (Ex D1 c1 #k. RepFail(D1,c1)@k)"
#endif

lemma Agree_DtoA:
  "All B C c s #t. Commit(B,C,<'DtoA',c,s>)@t ==>
     ( (Ex #j. Run(C,B,<'DtoA',c,s>)@j & j < t
          & not (Ex E F #k. Commit(E,F,<'DtoA',c,s>)@k & not (#k = #t)))
     | (Ex G c2 #r. RevealCRP(G,C,c2)@r & r < t)
     | (Ex c2 #r. BreakPUF(C,c2)@r & r < t)
     | (Ex #r. Model(C)@r & r < t)
     | (Ex D2 #r. Collide(C,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,C)@r & r < t) )"

lemma Agree_AtoD:
  "All B C c s #t. Commit(B,C,<'AtoD',c,s>)@t ==>
     ( (Ex #j. Run(C,B,<'AtoD',c,s>)@j & j < t
          & not (Ex E F #k. Commit(E,F,<'AtoD',c,s>)@k & not (#k = #t)))
     | (Ex G c2 #r. RevealCRP(G,B,c2)@r & r < t)
     | (Ex c2 #r. BreakPUF(B,c2)@r & r < t)
     | (Ex #r. Model(B)@r & r < t)
     | (Ex D2 #r. Collide(B,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,B)@r & r < t) )"

#ifdef SMALL_CAP
lemma DeviceAuth_byClass:
  "All A D x c n s #t. Commit(A,D,x)@t & VSess(A,D,c,n,s)@t & x = <'DtoA',c,s> ==>
     ( (Ex #j. Run(D,A,x)@j & j < t
          & not (Ex E F #k. Commit(E,F,x)@k & not (#k = #t)))
     | (Ex G #r. RevealCRP(G,D,c)@r & r < t)
     | (Ex #r. BreakPUF(D,c)@r & r < t)
     | (Ex #r. Model(D)@r & r < t)
     | (Ex D2 #r. Collide(D,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,D)@r & r < t) )"
#else
lemma DeviceAuth_byClass:
  "All A D x c n s #t. Commit(A,D,x)@t & VSess(A,D,c,n,s)@t & x = <'DtoA',c,s> ==>
     ( (Ex #j. Run(D,A,x)@j & j < t
          & not (Ex E F #k. Commit(E,F,x)@k & not (#k = #t)))
     | (Ex #r. RevealCRP(A,D,c)@r & r < t)
     | (Ex n2 #w #k. Start(A,D,c,n2)@w & BreakPUF(D,c)@k & w < k & k < t)
     | (Ex #r. Model(D)@r & r < t)
     | (Ex D2 #r. Collide(D,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,D)@r & r < t) )"
#endif

lemma Contrast_ExactOrOnlineOnly:
  "All A D x c n s #t. Commit(A,D,x)@t & VSess(A,D,c,n,s)@t & x = <'DtoA',c,s> ==>
     ( (Ex #j. Run(D,A,x)@j & j < t
          & not (Ex E F #k. Commit(E,F,x)@k & not (#k = #t)))
     | (Ex #r. RevealCRP(A,D,c)@r & r < t)
     | (Ex n2 #w #k. Start(A,D,c,n2)@w & BreakPUF(D,c)@k & w < k & k < t)
     | (Ex #r. Model(D)@r & r < t)
     | (Ex D2 #r. Collide(D,D2)@r & r < t)
     | (Ex D2 #r. Collide(D2,D)@r & r < t) )"

lemma Att_Desync:
  exists-trace
  "Ex A D s c #a #v #b. CAuth(D,s)@a & SVal(A,D,c,s)@v & CAuth(D,s)@b
     & a < v & v < b & not (Ex #m. CCommit(D,s)@m)"

lemma Att_Collide:
  exists-trace
  "Ex A D c n s #i. Commit(A,D,<'DtoA',c,s>)@i & VSess(A,D,c,n,s)@i
     & not (Ex #j. Run(D,A,<'DtoA',c,s>)@j)
     & (Ex D2 #k. Collide(D,D2)@k)
     & not (Ex D1 c1 #k. BreakPUF(D1,c1)@k)
     & not (Ex G D1 c1 #k. RevealCRP(G,D1,c1)@k)
     & not (Ex D1 #k. Model(D1)@k)"

lemma Att_Model:
  exists-trace
  "Ex A D c n s #i. Commit(A,D,<'DtoA',c,s>)@i & VSess(A,D,c,n,s)@i
     & not (Ex #j. Run(D,A,<'DtoA',c,s>)@j)
     & (Ex #k. Model(D)@k)
     & not (Ex D2 #k. Collide(D,D2)@k)"

lemma Att_RepFail:
  exists-trace
  "Ex D c #i. RepFail(D,c)@i"

lemma Cost_000_none:
  exists-trace
  "Ex A D c n s #i #w. Start(A,D,c,n)@w & VSess(A,D,c,n,s)@i & Commit(A,D,<'DtoA',c,s>)@i & not (Ex #j. Run(D,A,<'DtoA',c,s>)@j)
     & not (Ex #k. RevealCRP(A,D,c)@k)
     & not (Ex G D1 c2 #k. RevealCRP(G,D1,c2)@k & not (G = A & D1 = D & c2 = c))
     & not (Ex #k n2 #w2. BreakPUF(D,c)@k & Start(A,D,c,n2)@w2 & w2 < k)
     & not (Ex #k. BreakPUF(D,c)@k & not (Ex n2 #w2. Start(A,D,c,n2)@w2 & w2 < k))
     & not (Ex D1 c2 #k. BreakPUF(D1,c2)@k & not (D1 = D & c2 = c))
     & not (Ex D1 #k. Model(D1)@k)
     & not (Ex D1 D2 #k. Collide(D1,D2)@k)
     & not (Ex D1 #k. LeakFW(D1)@k)"

lemma Cost_001_RevSame:
  exists-trace
  "Ex A D c n s #i #w. Start(A,D,c,n)@w & VSess(A,D,c,n,s)@i & Commit(A,D,<'DtoA',c,s>)@i & not (Ex #j. Run(D,A,<'DtoA',c,s>)@j)
     & not (Ex G D1 c2 #k. RevealCRP(G,D1,c2)@k & not (G = A & D1 = D & c2 = c))
     & not (Ex #k n2 #w2. BreakPUF(D,c)@k & Start(A,D,c,n2)@w2 & w2 < k)
     & not (Ex #k. BreakPUF(D,c)@k & not (Ex n2 #w2. Start(A,D,c,n2)@w2 & w2 < k))
     & not (Ex D1 c2 #k. BreakPUF(D1,c2)@k & not (D1 = D & c2 = c))
     & not (Ex D1 #k. Model(D1)@k)
     & not (Ex D1 D2 #k. Collide(D1,D2)@k)
     & not (Ex D1 #k. LeakFW(D1)@k)"

lemma Cost_002_RevElse:
  exists-trace
  "Ex A D c n s #i #w. Start(A,D,c,n)@w & VSess(A,D,c,n,s)@i & Commit(A,D,<'DtoA',c,s>)@i & not (Ex #j. Run(D,A,<'DtoA',c,s>)@j)
     & not (Ex #k. RevealCRP(A,D,c)@k)
     & not (Ex #k n2 #w2. BreakPUF(D,c)@k & Start(A,D,c,n2)@w2 & w2 < k)
     & not (Ex #k. BreakPUF(D,c)@k & not (Ex n2 #w2. Start(A,D,c,n2)@w2 & w2 < k))
     & not (Ex D1 c2 #k. BreakPUF(D1,c2)@k & not (D1 = D & c2 = c))
     & not (Ex D1 #k. Model(D1)@k)
     & not (Ex D1 D2 #k. Collide(D1,D2)@k)
     & not (Ex D1 #k. LeakFW(D1)@k)"

lemma Cost_003_BrkOnline:
  exists-trace
  "Ex A D c n s #i #w. Start(A,D,c,n)@w & VSess(A,D,c,n,s)@i & Commit(A,D,<'DtoA',c,s>)@i & not (Ex #j. Run(D,A,<'DtoA',c,s>)@j)
