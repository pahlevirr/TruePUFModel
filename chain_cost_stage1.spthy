  "Ex A D c n m #i #w. Start(A,D,c,n)@w & VSess(A,D,c,n,m)@i & Commit(A,D,<'DtoA',c,m>)@i & not (Ex #j. Run(D,A,<'DtoA',c,m>)@j)
